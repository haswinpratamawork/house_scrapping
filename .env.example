# Copy to .env and adjust. .env is gitignored.

# PostgreSQL connection (local now, Cloud SQL later)
DATABASE_URL=postgresql://localhost:5432/house_scrapping

# Polite scraping: seconds between requests (randomized within [min, max])
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0
# Max simultaneous requests (keep small to stay under anti-bot radar)
MAX_CONCURRENCY=2
# Retry attempts on 429/5xx/timeout before skipping a URL
MAX_RETRIES=4

# Identify the scraper politely
USER_AGENT=house-scrapping/0.1 (+https://github.com/haswinpratamawork/house_scrapping)

# Source base URL (override only if needed)
BASE_URL=https://www.rumah123.com
